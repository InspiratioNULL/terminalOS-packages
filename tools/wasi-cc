#!/bin/sh
# A C compiler that produces wasm32-wasi binaries which are runnable *here*.
#
# Autotools configure scripts answer dozens of questions by compiling a test
# program and running it. Told to cross compile they cannot, and fall back to
# guesses, or refuse outright. So this wrapper compiles the link step to
# <out>.wasm and leaves a small shell script at <out> that runs it through the
# same wasm3 build terminalOS ships. configure then sees a compiler whose
# output it can execute, decides it is not cross compiling, and every run-time
# test is answered by the WebAssembly runtime the package will actually use.
#
# Usage: CC=tools/wasi-cc ./configure && make
set -e

ZIG="${ZIG:-zig}"
WASM3="${WASM3:-$(cd "$(dirname "$0")" && pwd)/wasm3-harness}"
TARGET_FLAGS="-target wasm32-wasi -D_WASI_EMULATED_SIGNAL -D_WASI_EMULATED_PROCESS_CLOCKS -D_WASI_EMULATED_GETPID"
TARGET_LIBS="-lwasi-emulated-signal -lwasi-emulated-process-clocks -lwasi-emulated-getpid"

out=""
compile_only=no
next_is_out=no
for arg in "$@"; do
  if [ "$next_is_out" = yes ]; then out="$arg"; next_is_out=no; continue; fi
  case "$arg" in
    -o) next_is_out=yes ;;
    -c|-E|-S|-M|-MM) compile_only=yes ;;
  esac
done

# Compile-only, or output that is already an object/library: nothing to wrap.
linking=yes
[ "$compile_only" = yes ] && linking=no
case "$out" in
  *.o|*.lo|*.a|*.so|*.wasm) linking=no ;;
esac

# A link with no -o writes a.out. Configure scripts generated by the autoconf
# that ncurses still ships compile their first test program exactly that way
# and then try to run ./a.out, so the stub has to land there too, or the whole
# build is turned away with "cannot run C compiled programs".
[ "$linking" = yes ] && [ -z "$out" ] && out=a.out

if [ "$linking" = no ]; then
  exec $ZIG cc $TARGET_FLAGS "$@" $TARGET_LIBS
fi

# Link to <out>.wasm, then leave an executable stub at <out>.
wasm="$out.wasm"
$ZIG cc $TARGET_FLAGS "$@" $TARGET_LIBS
[ -f "$out" ] && mv "$out" "$wasm"
case "$wasm" in
  /*) abs="$wasm" ;;
  *)  abs="$(pwd)/$wasm" ;;
esac
printf '#!/bin/sh\nexec "%s" "%s" "$@"\n' "$WASM3" "$abs" > "$out"
chmod +x "$out"
